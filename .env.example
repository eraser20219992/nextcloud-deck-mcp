# Nextcloud connection (required)
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=ai_agent
# Use an app password: Nextcloud -> Personal settings -> App passwords
NEXTCLOUD_APP_PASSWORD=changeme

# Board and lane (list) to work on - name or numeric id (required, name or id)
DECK_BOARD=CMA
DECK_LANE=AI Agent
# Optional numeric overrides if name lookup is ambiguous:
#DECK_BOARD_ID=11
#DECK_LANE_ID=49

# Only cards assigned to this user are picked up (defaults to NEXTCLOUD_USERNAME)
#DECK_ASSIGNEE=ai_agent
